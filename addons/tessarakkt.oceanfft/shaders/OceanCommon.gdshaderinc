


group_uniforms Internal;
/******************************************************************************/
// These are intended to be updated during runtime. Setting values in the editor
// may not have the desired result.

// For inverting surface normals, for underwater effect
uniform float normal_factor = 1.0;

// The UV scales for each cascade.
// Updated on initialization only by Ocean3D._ready()
uniform float cascade_uv_scales;

// The overall UV scale for all cascades.
// Updated on initialization only by Ocean3D._ready()
uniform float uv_scale = 0.001953125;

// The "accumulated wind" that has blown, for wave scrolling from wind.
// Updated each frame by Ocean3D._process()
uniform vec2 wind_uv_offset = vec2(0.0, 0.0);

// The displacement map cascades generated by the compute shaders.
// Updated with each call to Ocean3D.simulate()
uniform sampler2D cascade_displacements;

uniform sampler2D tb_displacement_map;

// The maximum distance from the camera a fragment can be visible. Beyond this
// distance the fragment will have ALPHA = 0.0
// This is set on initialization only by Quadtree3D._ready()
uniform float view_distance_max = 16000.0;


group_uniforms Internal.DomainWarp;
/******************************************************************************/
// Apply a static domain warp texture to the displacement map UV reads in order
// to break up tiling artifacts when viewing large distances.
// Static domain warp is used rather than animated or player centered to avoid
// vertex/UV swimming artifacts.

// Controls how large the domain_warp_texture is stretched horizontally.
// Smaller numbers result in more horizontal stretching.
// To stretch the texture to cover X units, set this value to 1.0 / X
uniform float domain_warp_uv_scale : hint_range(0.0, 1.0, 0.00000001) = 0.0000625;

// Controls how much distortion is applied to the displacement map UV reads
uniform float domain_warp_strength = 1500.0;

// Noise texture used to domain warp the displacement map UV reads to break up
// tiling at large distances from the camera.
uniform sampler2D domain_warp_texture;

// uniform sampler2D flow_map;

group_uniforms;

vec2 hash ( vec2 p)
{
return fract ( sin (( p ) * mat2 (vec2(127.1 , 311.7 ),vec2( 269.5 , 183.3)))*43758.5453) ;
}

void TriangleGrid ( vec2 uv ,out float w1 , out float w2 , out float w3 ,out ivec2 vertex1 , out ivec2 vertex2 , out ivec2 vertex3 ){
	// Scaling of the input
	uv *= 3.464; // 2 * sqrt (3)
	// Skew input space into simplex triangle grid
	const mat2 gridToSkewedGrid = mat2 (vec2(1.0 , 0.0) ,vec2( -0.57735027 , 1.15470054)) ;
	vec2 skewedCoord = gridToSkewedGrid * uv ;
	// Compute local triangle vertex IDs and local barycentric coordinates
	ivec2 baseId = ivec2 ( floor ( skewedCoord ));
	vec3 temp = vec3 ( fract ( skewedCoord ) , 0) ;
	temp .z = 1.0 - temp . x - temp .y;
	if ( temp . z > 0.0){
		w1 = temp .z;
		w2 = temp .y;
		w3 = temp .x;
		vertex1 = baseId ;
		vertex2 = baseId + ivec2 (0 , 1) ;
		vertex3 = baseId + ivec2 (1 , 0) ;
	}
	else{
		w1 = - temp .z ;
		w2 = 1.0 - temp .y;
		w3 = 1.0 - temp .x;
	vertex1 = baseId + ivec2 (1 , 1) ;
	vertex2 = baseId + ivec2 (1 , 0) ;
	vertex3 = baseId + ivec2 (0 , 1) ;
	}
}

// utiliser une texture pour calculer la direction des vagues
vec2 get_flow_direction(vec2 uv) {
    // vec2 flow = texture(flow_map, uv).rg;
	
    //vec2 flow = uv - vec2(0.5, 0.5);
	//if(uv.x < 0.5){
		//uv.x = -uv.x;
	//}
	//if(uv.y < 0.5){
		//uv.y = -uv.y;
	//}
	if(uv == vec2(0, 0)) return normalize(vec2(0.001, 0));
	return normalize(uv);
}

uniform float tb_scale = 1.0;


void TriangleGrid(vec2 uv,
 out float w1,out float w2, out float w3,
 out ivec2 vertex1, out ivec2 vertex2, out ivec2 vertex3){

	uv *= 3.464; // 2 * sqrt(3)

	const mat2 gridToSkewedGrid = mat2(vec2(1.0, 0.0), vec2(-0.57735027, 1.15470054));
	vec2 skewedCoord = gridToSkewedGrid * uv;

	ivec2 baseId = ivec2(floor(skewedCoord));
	vec3 temp = vec3(fract(skewedCoord), 0);
	temp.z = 1.0 - temp.x - temp.y;
	if (temp.z > 0.0)
	{
		w1 = temp.z;
		w2 = temp.y;
		w3 = temp.x;
		vertex1 = baseId;
		vertex2 = baseId + ivec2(0, 1); 
		vertex3 = baseId + ivec2(1, 0);
	}
	else
	{
		w1 = -temp.z;
		w2 = 1.0 - temp.y;
		w3 = 1.0 - temp.x;
		vertex1 = baseId + ivec2(1, 1);
		vertex2 = baseId + ivec2(1, 0);
		vertex3 = baseId + ivec2(0, 1);
	}
}

vec2 TriangleGridToUV(ivec2 vertex) {
    const mat2 skewedToGrid = inverse(mat2(vec2(1.0, 0.0), vec2(-0.57735027, 1.15470054)));
    return skewedToGrid * vec2(vertex) / 3.464;
}


vec2 hash2(vec2 p)
{
	return fract(sin((p) * mat2(vec2(127.1, 311.7), vec2(269.5, 183.3)) )*43758.5453);
}

vec3 get_displacement_tiling(vec2 uv)
{
	uv *=  tb_scale * 0.0000625;
	
	// Get triangle info
	float w1, w2, w3;
	ivec2 vertex1, vertex2, vertex3;
	TriangleGrid(uv, w1, w2, w3, vertex1, vertex2, vertex3);

	// Assign random offset to each triangle vertex
	vec2 uv1 = uv + hash2(vec2(vertex1));
	vec2 uv2 = uv + hash2(vec2(vertex2));
	vec2 uv3 = uv + hash2(vec2(vertex3));
	
	vec2 hexaCenter1 = TriangleGridToUV(vertex1);
	vec2 hexaCenter2 = TriangleGridToUV(vertex2);
	vec2 hexaCenter3 = TriangleGridToUV(vertex3);

	vec2 flow_direction1 = get_flow_direction(hexaCenter1);
	vec2 flow_direction2 = get_flow_direction(hexaCenter2);
	vec2 flow_direction3 = get_flow_direction(hexaCenter3);
	
	float theta1 = atan(flow_direction1.y, flow_direction1.x) - atan(wind_uv_offset.y, wind_uv_offset.x);
	float theta2 = atan(flow_direction2.y, flow_direction2.x) - atan(wind_uv_offset.y, wind_uv_offset.x);
	float theta3 = atan(flow_direction3.y, flow_direction3.x) - atan(wind_uv_offset.y, wind_uv_offset.x);
	
	mat2 rotation2_1 = mat2(vec2(cos(theta1), -sin(theta1)), vec2(sin(theta1), cos(theta1)));
	mat2 rotation2_2 = mat2(vec2(cos(theta2), -sin(theta2)), vec2(sin(theta2), cos(theta2)));
	mat2 rotation2_3 = mat2(vec2(cos(theta3), -sin(theta3)), vec2(sin(theta3), cos(theta3)));

	vec3 I1 = texture(cascade_displacements, rotation2_1 * uv1 + wind_uv_offset).rgb;
	vec3 I2 = texture(cascade_displacements, rotation2_2 * uv2 + wind_uv_offset).rgb;
	vec3 I3 = texture(cascade_displacements, rotation2_3 * uv3 + wind_uv_offset).rgb;

	mat3 rotation3_1 = mat3(vec3(cos(theta1), 0, -sin(theta1)), vec3(0, 1, 0), vec3(sin(theta1), 0, cos(theta1)));
	mat3 rotation3_2 = mat3(vec3(cos(theta2), 0, -sin(theta2)), vec3(0, 1, 0), vec3(sin(theta2), 0, cos(theta2)));
	mat3 rotation3_3 = mat3(vec3(cos(theta3), 0, -sin(theta3)), vec3(0, 1, 0), vec3(sin(theta3), 0, cos(theta3)));

	//Linear blending a changer
	vec3 displacement = w1 * rotation3_1 * I1 + w2 * rotation3_2 * I2 + w3 * rotation3_3 * I3;

	return displacement;
}

//ne pas utiliser
vec3 get_normal(vec3 position )
{

	vec3 dx = position + vec3(1.0,0,0);
	vec3 displacement_dx = get_displacement_tiling(dx.xz);
	vec3 new_x = dx + displacement_dx * vec3(0,1,0);

	vec3 dz = position + vec3(0,0,1.0);
	vec3 displacement_dz = get_displacement_tiling(dz.xz);
	vec3 new_z = dz + displacement_dz * vec3(0,1,0);

	vec3 tangent1 = new_x - position;
	vec3 tangent2 = new_z - position;

	vec3 normal = cross(tangent1, tangent2);
	normal = normalize(normal);

	return normal;
}

// Get the total wave displacement of a vertex from all cascades.
vec3 get_displacement(vec2 uv) {
	vec3 displacement = vec3(0.0);

		displacement += texture(cascade_displacements,
				uv * uv_scale * (1.0 / cascade_uv_scales) + wind_uv_offset * cascade_uv_scales).rgb;

	return displacement;
}

// rotation2 est censé se faire une fois pour chaque hexagone
// trouver coord uv correspondant aux centres des héxagones
// -> inverser la matrice pour ça 
// réseau de neurones approxime on a pas besoin on a déjà des maths bien 


// Calculate surface normals and Jacobian determinant for a given coordinate.
// The normal will be packed in the XYZ channels, and the Jacobian determinant
// will be packed in the W channel.
vec4 get_normals_jacobian(vec2 uv, vec3 displacement) {
	// Surface Normals
	float offset = 0.1;

	vec3 right = (vec3(offset, get_displacement_tiling(uv + vec2(offset, 0.0)).y, 0.0)) - displacement;
	vec3 left = (vec3(-offset, get_displacement_tiling(uv + vec2(-offset, 0.0)).y, 0.0)) - displacement;
	vec3 bottom = (vec3(0.0, get_displacement_tiling(uv + vec2(0.0, offset)).y, offset)) - displacement;
	vec3 top = (vec3(0.0, get_displacement_tiling(uv + vec2(0.0, -offset)).y, -offset)) - displacement;

	vec3 top_right = cross(right, top);
	vec3 top_left = cross(top, left);
	vec3 bottom_left = cross(left, bottom);
	vec3 bottom_right = cross(bottom, right);

	vec3 normal = normalize(top_right + top_left + bottom_left + bottom_right) * normal_factor;

	// Jacobian Determinant
	// Used for foam/whitecap rendering
	float jxx = right.x / offset;
	float jxy = right.y / offset;
	float jyx = bottom.x / offset;
	float jyy = bottom.y / offset;
	float jacobian_determinant = (jxx * jyy) - (jxy * jyx);

	return vec4(normal, jacobian_determinant);
}

// Apply domain warp to the given coordinate. This has no effect at 0 distance,
// and gets stronger linearly as distance increases. It will reach 100% strength
// at view_distance_max.
vec2 domain_warp(vec2 uv, float linear_dist) {
	vec2 domain_warp = vec2(
			texture(domain_warp_texture, uv * domain_warp_uv_scale).r,
			texture(domain_warp_texture, -uv * domain_warp_uv_scale).r);

	domain_warp *= domain_warp_strength * (linear_dist / view_distance_max);

	return uv + domain_warp;
}


